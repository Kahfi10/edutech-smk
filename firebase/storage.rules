rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Materials: semua bisa baca, hanya TEACHER & ADMIN yang bisa upload
    match /materials/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 100 * 1024 * 1024; // max 100 MB
    }

    // Submissions: siswa upload, teacher bisa baca
    match /submissions/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.size < 50 * 1024 * 1024; // max 50 MB
    }

    // Piket photos
    match /piket/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 10 * 1024 * 1024; // max 10 MB
    }

    // Profile photos
    match /profiles/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024; // max 5 MB
    }
  }
}
